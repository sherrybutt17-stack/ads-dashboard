# ---------------------------------------------------------------
# Database — Neon, Supabase, or any Postgres
# ---------------------------------------------------------------
# The driver is chosen automatically from the hostname, so either works.
#
# Neon: https://console.neon.tech → create project → POOLED connection string
DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
#
# Supabase: Settings → Database → Connection string → Transaction pooler.
# Use the POOLER url (port 6543), NOT the direct one (5432) — serverless
# functions open a connection per invocation and exhaust the direct limit.
# DATABASE_URL="postgresql://postgres.xxxx:pass@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# ---------------------------------------------------------------
# Meta Marketing API
# ---------------------------------------------------------------
# See SETUP.md §1. The system user token never expires.
META_APP_ID=""
META_APP_SECRET=""
META_SYSTEM_USER_TOKEN=""

# Pin the version explicitly. Expired Marketing API versions do NOT error —
# they silently fall back to an older one, which changes behaviour without
# warning. Versions last roughly 12 months; review twice a year.
META_API_VERSION="v25.0"

# ---------------------------------------------------------------
# Google Ads API  (OPTIONAL — a client can run Meta only)
# ---------------------------------------------------------------
# See SETUP.md §2b. These are AGENCY-level: one MCC (manager) account's
# developer token + one refresh token authorize every client account linked to
# the MCC, so nothing here is per-client (a client only supplies its Customer
# ID in the wizard). Leave all blank to disable Google entirely.
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
# Model A (agency MCC) only. One-time, minted by the MCC-owner Google user with
# offline scope. Reusable — unlike GHL's, Google refresh tokens do not rotate.
# Not needed for Model B, where each client signs in and their token is stored
# encrypted against their own accounts.
GOOGLE_ADS_REFRESH_TOKEN=""
# The MCC (manager) account id, DIGITS ONLY, no dashes. The DEFAULT
# login-customer-id — accounts connected by client sign-in store their own
# manager id and ignore this.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""
# Pin the version. Google HARD-ERRORS on a sunset version (better than Meta,
# which silently falls back and hands you wrong numbers). v18 was the previous
# default here and is long past sunset — confirm the current one against
# Google's release notes before the first real call.
GOOGLE_ADS_API_VERSION="v22"

# ---------------------------------------------------------------
# TikTok Marketing API  (OPTIONAL — a client can run Meta only)
# ---------------------------------------------------------------
# From the app you create at https://business-api.tiktok.com/portal.
# Blank disables the "Continue with TikTok" button entirely; nothing else in the
# app changes, so a book with no TikTok spend is unaffected.
#
# Three things about this app are decided at CREATION and cannot be edited
# afterwards — a mistake means a whole new app, a second review, and
# re-authorizing every advertiser, against a cap of 5 apps per developer:
#
#   * Scopes. Fixed at creation, NOT requested per authorization — which is why
#     buildTiktokAuthorizeUrl sends none. We need Ad Account Management,
#     Reporting, Ads Management, and Lead Management (the last for Lead Ads
#     retrieval, which is the only way native lead forms ever get attributed).
#   * The Advertiser redirect URL. ONE url, not a list, matched exactly. It must
#     equal NEXT_PUBLIC_APP_URL + /api/oauth/tiktok/callback — so moving between
#     localhost and production means editing it in TikTok's portal.
#   * App review. 2-3 business days at TikTok's quote, longer in practice.
#
# Note there is no TIKTOK_API_VERSION here, unlike Meta and Google: v1.3 is
# pinned in lib/tiktok/client.ts because the request shape is version-specific.
TIKTOK_APP_ID=""
TIKTOK_APP_SECRET=""

# ---------------------------------------------------------------
# GoHighLevel marketplace app (OAuth)
# ---------------------------------------------------------------
# From https://marketplace.gohighlevel.com → My Apps → your app.
# This is what enables one-click client onboarding: webhooks are configured
# once on the app, so an installed sub-account streams events with no
# per-client workflow building.
GHL_CLIENT_ID=""
GHL_CLIENT_SECRET=""

# Optional. GHL publishes an Ed25519 public key for webhook signatures.
# When unset, signature verification is SKIPPED rather than failing — rejecting
# unverified deliveries would silently discard stage transitions that GHL has
# no API to replay. Set it once you have the key from the marketplace docs.
GHL_WEBHOOK_PUBLIC_KEY=""

# ---------------------------------------------------------------
# App
# ---------------------------------------------------------------
# Encrypts per-client GHL tokens at rest.  openssl rand -hex 32
ENCRYPTION_KEY=""

# Optional. Signs the dashboard session cookie (HMAC-SHA256). If unset it falls
# back to ENCRYPTION_KEY, so you only need this to rotate sessions independently
# of the encryption key.  openssl rand -hex 32
AUTH_SECRET=""

# Guards /api/cron/*, which must stay reachable without the password gate.
# openssl rand -hex 32
CRON_SECRET=""

# Shared password for the dashboard. REQUIRED in production — if it is unset on a
# production deploy the app fails CLOSED (returns 503) rather than serving every
# client's data publicly. Local dev without it runs open for convenience.
DASHBOARD_PASSWORD=""

# Which account the shared password acts as, once real user accounts exist.
#
# Leave blank and the shared password is accepted only on a first run (empty
# `users` table) — after that, sign in with an email, or use "Forgot your
# password?". Set it to a user's email and the shared password becomes a second
# credential for THAT person: revocable by disabling them, and named in the
# audit log rather than acting as an anonymous "staff".
DASHBOARD_BOOTSTRAP_EMAIL=""

# The public origin of this deployment. More depends on it than the name
# suggests: the per-client webhook URL an operator pastes into GoHighLevel, the
# password-reset and address-verification links that go out by email, the
# scheduled-report link, and the OAuth redirect_uri for Meta, Google, TikTok and
# GHL — which must match the URL registered with each provider EXACTLY.
#
# On Vercel this is recoverable if unset (the deployment's own domain is used),
# but set it anyway: a custom domain in front of a Vercel project is invisible
# to us, and links should send people to the address they recognise.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------
# Written summaries (optional)
# ---------------------------------------------------------------
# Drafts the weekly client update on the dashboard. Entirely optional: without
# it the panel says so and every figure on every page is unaffected — the model
# never computes a number, it only writes sentences about numbers the metrics
# engine already produced, and each one is checked back against them.
#
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# ---------------------------------------------------------------
# Server-rendered PDF (optional)
# ---------------------------------------------------------------
# Without this, the report's "Download PDF" button is absent and printing from
# the browser still works exactly as before. What it buys is the page margin:
# Chrome stamps the document title, the date, the SOURCE URL and the page number
# into every printed page whenever its "Headers and footers" box is ticked —
# which is the default, and which no CSS or JavaScript can reach. So a report a
# client forwards to their board carries this app's URL down the side of it.
# Rendering server-side removes the browser chrome because there is no browser
# window.
#
# Requires NEXT_PUBLIC_APP_URL to be a PUBLIC address: the render service fetches
# the report from us, and it cannot see localhost. Locally, use the print button.
#
# browserless.io (default) or pdfshift.io.
PDF_RENDER_KEY=""
# "browserless" (default) or "pdfshift".
PDF_RENDER_PROVIDER=""
# Only for a self-hosted instance or a non-default region.
PDF_RENDER_URL=""

# ---------------------------------------------------------------
# Scheduled report email (optional)
# ---------------------------------------------------------------
# Emails clients a LINK to their report on a weekly or monthly schedule. Without
# these, the schedule panel says it is not configured and nothing else changes.
#
# 🔴 REPORT_FROM must be on a domain you control, with SPF, DKIM and DMARC
# published and the domain verified with the provider. Mail from an
# unauthenticated domain is filed as spam — and a report sitting in a junk
# folder is worse than one never sent, because you believe it arrived and the
# client believes it never did. A gmail.com sender is rejected outright
# (DMARC p=reject) and the app refuses it before calling the provider.
RESEND_API_KEY=""
REPORT_FROM="Growth Guild <reports@yourdomain.com>"
# Optional — where replies go, if not the sender.
REPORT_REPLY_TO=""
# Only for a compatible API or a self-hosted relay.
RESEND_API_URL=""
