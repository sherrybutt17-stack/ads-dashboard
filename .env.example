# ---------------------------------------------------------------
# Database — Neon, Supabase, or any Postgres
# ---------------------------------------------------------------
# The driver is chosen automatically from the hostname, so either works.
#
# Neon: https://console.neon.tech → create project → POOLED connection string
DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
#
# Supabase: Settings → Database → Connection string → Transaction pooler.
# Use the POOLER url (port 6543), NOT the direct one (5432) — serverless
# functions open a connection per invocation and exhaust the direct limit.
# DATABASE_URL="postgresql://postgres.xxxx:pass@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# ---------------------------------------------------------------
# Meta Marketing API
# ---------------------------------------------------------------
# See SETUP.md §1. The system user token never expires.
META_APP_ID=""
META_APP_SECRET=""
META_SYSTEM_USER_TOKEN=""

# Pin the version explicitly. Expired Marketing API versions do NOT error —
# they silently fall back to an older one, which changes behaviour without
# warning. Versions last roughly 12 months; review twice a year.
META_API_VERSION="v25.0"

# ---------------------------------------------------------------
# Google Ads API  (OPTIONAL — a client can run Meta only)
# ---------------------------------------------------------------
# See SETUP.md §2b. These are AGENCY-level: one MCC (manager) account's
# developer token + one refresh token authorize every client account linked to
# the MCC, so nothing here is per-client (a client only supplies its Customer
# ID in the wizard). Leave all blank to disable Google entirely.
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
# One-time, minted by the MCC-owner Google user with offline scope. Reusable —
# unlike GHL's, Google refresh tokens do not rotate on use.
GOOGLE_ADS_REFRESH_TOKEN=""
# The MCC (manager) account id, DIGITS ONLY, no dashes. Sent as login-customer-id.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""
# Pin the version, same reasoning as Meta. Google deprecates versions ~yearly.
GOOGLE_ADS_API_VERSION="v18"

# ---------------------------------------------------------------
# GoHighLevel marketplace app (OAuth)
# ---------------------------------------------------------------
# From https://marketplace.gohighlevel.com → My Apps → your app.
# This is what enables one-click client onboarding: webhooks are configured
# once on the app, so an installed sub-account streams events with no
# per-client workflow building.
GHL_CLIENT_ID=""
GHL_CLIENT_SECRET=""

# Optional. GHL publishes an Ed25519 public key for webhook signatures.
# When unset, signature verification is SKIPPED rather than failing — rejecting
# unverified deliveries would silently discard stage transitions that GHL has
# no API to replay. Set it once you have the key from the marketplace docs.
GHL_WEBHOOK_PUBLIC_KEY=""

# ---------------------------------------------------------------
# App
# ---------------------------------------------------------------
# Encrypts per-client GHL tokens at rest.  openssl rand -hex 32
ENCRYPTION_KEY=""

# Optional. Signs the dashboard session cookie (HMAC-SHA256). If unset it falls
# back to ENCRYPTION_KEY, so you only need this to rotate sessions independently
# of the encryption key.  openssl rand -hex 32
AUTH_SECRET=""

# Guards /api/cron/*, which must stay reachable without the password gate.
# openssl rand -hex 32
CRON_SECRET=""

# Shared password for the dashboard. REQUIRED in production — if it is unset on a
# production deploy the app fails CLOSED (returns 503) rather than serving every
# client's data publicly. Local dev without it runs open for convenience.
DASHBOARD_PASSWORD=""

# Public origin, used to render the per-client webhook URL during onboarding.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
